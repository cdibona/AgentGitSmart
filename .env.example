# Copy to .env (or export these in the hook environment).

# Repo to index. On a server the post-receive hook gets this from $GIT_DIR,
# so you usually do NOT set this there. Set it for the query service / CLI use.
# AGENTCACHE_REPO_DIR=/srv/git/myrepo.git

# Side-ref namespace for cache commits (kept out of refs/heads).
AGENTCACHE_REF_PREFIX=refs/agent-cache

# Symbol indexer. universal-ctags strongly recommended.
AGENTCACHE_CTAGS_BIN=ctags

# Where to write blobless bootstrap bundles (then sync to object storage/CDN).
# Leave unset to disable bundle generation.
# AGENTCACHE_BUNDLE_DIR=/srv/git/bundles
AGENTCACHE_BUNDLE_FILTER=blob:none

# Identity stamped on the orphan cache commits.
AGENTCACHE_BOT_NAME=AgentCache Bot
AGENTCACHE_BOT_EMAIL=agentcache@localhost

# Query service bind.
AGENTCACHE_SERVICE_HOST=127.0.0.1
AGENTCACHE_SERVICE_PORT=8765

# Public URL embedded in cache artifacts so agents can self-discover the service.
# Leave blank (default) to omit the URL from artifacts.
# AGENTCACHE_SERVICE_URL=

# Build cache on the first HTTP request if the hook did not already generate it.
AGENTCACHE_LAZY_GENERATION=true

# --- Delta symbol indexing (new in v0.2.0) ---
# Re-ctags only changed files per push; carries forward unchanged symbols.
# Requires universal-ctags: sudo apt-get install -y universal-ctags
# Boolean vars accept 1/true/yes/on (case-insensitive).

# Enable delta re-indexing (disable to force a full rebuild every push).
AGENTCACHE_DELTA_SYMBOLS=true

# Allow delta indexing on merge commits (uses the first parent only).
AGENTCACHE_DELTA_ON_MERGE=true

# Fall back to a full rebuild when (changed files / total files) exceeds this
# ratio. Unset (default) means no ratio guard is applied.
# AGENTCACHE_DELTA_MAX_RATIO=
