# Copy to .env (or export these in the hook environment).

# Repo to index. On a server the post-receive hook gets this from $GIT_DIR,
# so you usually do NOT set this there. Set it for the query service / CLI use.
# AGENTCACHE_REPO_DIR=/srv/git/myrepo.git

# Side-ref namespace for cache commits (kept out of refs/heads).
AGENTCACHE_REF_PREFIX=refs/agent-cache

# Symbol indexer. universal-ctags strongly recommended.
AGENTCACHE_CTAGS_BIN=ctags

# Where to write blobless bootstrap bundles (then sync to object storage/CDN).
# Leave unset to disable bundle generation.
# AGENTCACHE_BUNDLE_DIR=/srv/git/bundles
AGENTCACHE_BUNDLE_FILTER=blob:none

# Identity stamped on the orphan cache commits.
AGENTCACHE_BOT_NAME=AgentCache Bot
AGENTCACHE_BOT_EMAIL=agentcache@localhost

# Query service bind.
AGENTCACHE_SERVICE_HOST=127.0.0.1
AGENTCACHE_SERVICE_PORT=8765
